# INTERFACE GRAPHIQUE BENTO UI/UX PRO MAX
# ==========================================
def launch_gui(initial_text=""):
    from PyQt6.QtWidgets import (
        QApplication, QWidget, QVBoxLayout, QHBoxLayout,
        QLabel, QPlainTextEdit, QPushButton, QFileDialog, QFrame, QSizePolicy
    )
    from PyQt6.QtGui import QPixmap, QImage, QIcon, QFont, QKeySequence, QShortcut, QPainter
    from PyQt6.QtSvg import QSvgRenderer
    from PyQt6.QtCore import Qt, QTimer, QByteArray, QSize

    def create_svg_icon(name, color="#ffffff", size=18):
        """Convertit un SVG Lucide en QIcon vectoriel à la couleur spécifiée."""
        svg_xml = SVG_ICONS.get(name, "")
        if not svg_xml:
            return QIcon()
        colored_svg = svg_xml.replace('stroke="currentColor"', f'stroke="{color}"')
        renderer = QSvgRenderer(QByteArray(colored_svg.encode("utf-8")))
        pixmap = QPixmap(size, size)
        pixmap.fill(Qt.GlobalColor.transparent)
        painter = QPainter(pixmap)
        renderer.render(painter)
        painter.end()
        return QIcon(pixmap)

    def create_svg_pixmap(name, color="#ffffff", size=32):
        """Convertit un SVG Lucide en QPixmap."""
        svg_xml = SVG_ICONS.get(name, "")
        if not svg_xml:
            return QPixmap()
        colored_svg = svg_xml.replace('stroke="currentColor"', f'stroke="{color}"')
        renderer = QSvgRenderer(QByteArray(colored_svg.encode("utf-8")))
        pixmap = QPixmap(size, size)
        pixmap.fill(Qt.GlobalColor.transparent)
        painter = QPainter(pixmap)
        renderer.render(painter)
        painter.end()
        return pixmap

