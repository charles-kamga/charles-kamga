# ==========================================
# UTILITAIRES SYSTÈME & WAYLAND
# ==========================================
def get_clipboard_text():
    """Récupère le texte depuis le presse-papier Wayland."""
    try:
        res = subprocess.run(
            ["wl-paste", "--no-newline"],
            capture_output=True,
            text=True,
            timeout=1
        )
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    except Exception:
        pass
    return ""

def generate_qr_bytes(text, scale=8, margin=2):
    """Génère une image PNG de code QR via qrencode et renvoie les octets bruts."""
    if not text:
        return None
    try:
        res = subprocess.run(
            ["qrencode", "-s", str(scale), "-m", str(margin), "-o", "-", "--", text],
            capture_output=True,
            check=True
        )
        return res.stdout
    except subprocess.CalledProcessError as e:
        print(f"Erreur qrencode: {e}", file=sys.stderr)
        return None

def copy_image_to_clipboard(png_bytes):
    """Copie une image PNG dans le presse-papier Wayland."""
    if not png_bytes:
        return False
    try:
        proc = subprocess.Popen(
            ["wl-copy", "--type", "image/png"],
            stdin=subprocess.PIPE
        )
        proc.communicate(input=png_bytes)
        return proc.returncode == 0
    except Exception as e:
        print(f"Erreur wl-copy: {e}", file=sys.stderr)
        return False

def send_notification(title, message, icon="preferences-system-search"):
    """Envoie une notification système via notify-send."""
    try:
        subprocess.Popen(
            ["notify-send", "-a", "QR Generator", "-i", icon, title, message, "-t", "4000"]
        )
    except Exception:
        pass

def detect_content_type(text):
    """Analyse le contenu pour afficher un badge intelligent."""
    t = text.strip()
    if not t:
        return ("none", "En attente", "#64748b")
    if t.startswith("http://") or t.startswith("https://"):
        return ("globe", "Lien Web", "#60a5fa")
    if t.startswith("WIFI:"):
        return ("wifi", "Réseau Wi-Fi", "#34d399")
    if t.startswith("mailto:") or re.match(r"^[^@]+@[^@]+\.[^@]+$", t):
        return ("mail", "Adresse E-mail", "#f472b6")
    return ("text", "Texte brut", "#94a3b8")

# ==========================================
# CLI FAST MODE
# ==========================================
def launch_cli_clip():
    """Mode CLI sans interface : lit le presse-papier, génère le QR et le copie en image."""
    clip_text = get_clipboard_text()
    if not clip_text:
        send_notification("Générateur QR", "Aucun texte trouvé dans le presse-papier.", "dialog-warning")
        print("Erreur : Aucun texte trouvé dans le presse-papier.", file=sys.stderr)
        sys.exit(1)

    png_bytes = generate_qr_bytes(clip_text)
    if png_bytes and copy_image_to_clipboard(png_bytes):
        preview = clip_text[:35] + ("..." if len(clip_text) > 35 else "")
        send_notification("Code QR copié", f"Image générée et copiée : {preview}", "emblem-default")
        print("Image du code QR copiée dans le presse-papier.")
    else:
        send_notification("Générateur QR", "Échec de génération du code QR", "dialog-error")
        sys.exit(1)

