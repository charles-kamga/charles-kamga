            self.badge_type.setText(type_label)
            self.badge_type.setStyleSheet(f"""
                background-color: {color}18;
                border: 1px solid {color}35;
                color: {color};
                font-size: 11px;
                font-weight: 600;
                border-radius: 4px;
                padding: 2px 8px;
            """)

            self.update_ui_state(text)

        def update_ui_state(self, text):
            if not text:
                self.current_png_bytes = None
                self.white_frame.setVisible(False)
                self.empty_frame.setVisible(True)
                self.meta_info_label.setVisible(False)
                self.btn_copy.setEnabled(False)
                self.btn_save.setEnabled(False)
                return

            png_bytes = generate_qr_bytes(text)
            if png_bytes:
                self.current_png_bytes = png_bytes
                pixmap = QPixmap()
                pixmap.loadFromData(png_bytes, "PNG")
                scaled = pixmap.scaled(
                    230, 230,
                    Qt.AspectRatioMode.KeepAspectRatio,
                    Qt.TransformationMode.SmoothTransformation
                )
                self.qr_image_label.setPixmap(scaled)
                self.white_frame.setVisible(True)
                self.empty_frame.setVisible(False)
                self.meta_info_label.setVisible(True)
                self.meta_info_label.setText(f"PNG · {pixmap.width()}×{pixmap.height()} px · Correction ECC M")
                self.btn_copy.setEnabled(True)
                self.btn_save.setEnabled(True)
            else:
                self.current_png_bytes = None
                self.white_frame.setVisible(False)
                self.empty_frame.setVisible(True)
                self.meta_info_label.setVisible(False)
                self.btn_copy.setEnabled(False)
                self.btn_save.setEnabled(False)

        def paste_from_clipboard(self):
            clip = get_clipboard_text()
            if clip:
                self.text_edit.setPlainText(clip)
                self.text_edit.selectAll()
                self.text_edit.setFocus()

        def clear_text(self):
            self.text_edit.clear()
            self.text_edit.setFocus()

        def show_toast(self, message):
            self.toast_banner.setText(f"✓  {message}")
            self.toast_banner.setVisible(True)
            QTimer.singleShot(2600, lambda: self.toast_banner.setVisible(False))

        def copy_qr_image(self):
            if not self.current_png_bytes:
                return

            ok = copy_image_to_clipboard(self.current_png_bytes)
            try:
                img = QImage()
                img.loadFromData(self.current_png_bytes, "PNG")
                QApplication.clipboard().setImage(img)
                ok = True
            except Exception:
                pass

            if ok:
                self.show_toast("Image copiée dans le presse-papier")
                send_notification("QR Code copié", "L'image du QR code a été copiée dans votre presse-papier.")

        def save_qr_image(self):
            if not self.current_png_bytes:
                return

            pictures_dir = os.path.expanduser("~/Pictures")
            if not os.path.exists(pictures_dir):
                pictures_dir = os.path.expanduser("~")

            default_name = f"qrcode_{datetime.now().strftime('%Y%m%d_%H%M%S')}.png"
            default_path = os.path.join(pictures_dir, default_name)

            file_path, _ = QFileDialog.getSaveFileName(
                self,
                "Enregistrer le Code QR",
                default_path,
                "Images PNG (*.png)"
            )

            if file_path:
                try:
                    with open(file_path, "wb") as f:
                        f.write(self.current_png_bytes)
                    self.show_toast(f"Enregistré dans {os.path.basename(file_path)}")
                    send_notification("QR Code enregistré", f"Enregistré dans : {os.path.basename(file_path)}")
                except Exception as e:
                    send_notification("Erreur d'enregistrement", str(e), "dialog-error")

    win = QRStudioWindow(initial_text)
    win.show()
    sys.exit(app.exec())

# ==========================================
# POINT D'ENTRÉE PRINCIPAL
# ==========================================
def main():
    parser = argparse.ArgumentParser(
        description="Générateur de Code QR pour Wayland / Hyprland (UI/UX Pro Max)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Exemples :
  qr-generator                      # Ouvre l'interface Bento (auto-remplie avec le presse-papier)
  qr-generator "https://site.com"   # Ouvre l'interface avec ce lien
  qr-generator --clip               # Mode express : copie directement l'image du QR du presse-papier
  qr-generator -o mon_qr.png "texte" # Enregistre directement dans un fichier PNG
        """
    )
    parser.add_argument("text", nargs="?", default="", help="Texte ou URL à encoder")
    parser.add_argument("-c", "--clip", action="store_true", help="Générer directement depuis le presse-papier sans interface")
    parser.add_argument("-o", "--output", help="Enregistrer l'image du QR code directement dans un fichier PNG")
    parser.add_argument("--copy", action="store_true", help="Copier l'image générée dans le presse-papier et quitter")
    parser.add_argument("--gui", action="store_true", help="Forcer l'ouverture de l'interface graphique")

    args = parser.parse_args()

    if args.clip:
        launch_cli_clip()
        return

    if (args.output or args.copy) and not args.gui:
        target_text = args.text or get_clipboard_text()
        if not target_text:
            print("Erreur : Aucun texte fourni ni trouvé dans le presse-papier.", file=sys.stderr)
            sys.exit(1)

        png_bytes = generate_qr_bytes(target_text)
        if not png_bytes:
            print("Erreur : Échec de la génération du code QR.", file=sys.stderr)
            sys.exit(1)

        if args.output:
            with open(args.output, "wb") as f:
                f.write(png_bytes)
            print(f"Code QR enregistré dans : {args.output}")

        if args.copy:
            if copy_image_to_clipboard(png_bytes):
                print("Image du code QR copiée dans le presse-papier.")
            else:
                sys.exit(1)
        return

    launch_gui(args.text)

if __name__ == "__main__":
    main()
