#!/usr/bin/env bash
# qr-scan - Scanner de code QR pour Hyprland / Linux
# Supporte :
#  1. Capture d'écran interactive (slurp + grim) par défaut
#  2. Scan d'une image en argument (qr-scan image.png)
#  3. Scan depuis le presse-papier (qr-scan --clip)
#  4. Scan depuis la webcam (qr-scan --cam)

set -euo pipefail

notify() {
    local title="$1"
    local msg="$2"
    local is_url="${3:-false}"

    if command -v notify-send >/dev/null 2>&1; then
        (
            if [ "$is_url" = true ]; then
                action=$(notify-send -a "QR Scanner" -i preferences-system-search "$title" "$msg\n\n(Copié dans le presse-papier)" -A "open=Ouvrir le lien" -t 8000 2>/dev/null || true)
                if [ "$action" = "open" ]; then
                    xdg-open "$msg" >/dev/null 2>&1 &
                fi
            else
                notify-send -a "QR Scanner" -i preferences-system-search "$title" "$msg\n\n(Copié dans le presse-papier)" -t 5000 2>/dev/null || true
            fi
        ) &
    fi
}

notify_err() {
    local msg="$1"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "QR Scanner" -u low -i dialog-error "QR Scanner" "$msg" -t 4000 2>/dev/null || true
    fi
    echo "$msg" >&2
}

process_text() {
    local text="$1"
    if [ -z "$text" ]; then
        notify_err "Aucun code QR détecté."
        exit 1
    fi

    echo "$text"
    echo -n "$text" | wl-copy 2>/dev/null || true

    if [[ "$text" =~ ^https?:// ]]; then
        notify "Code QR détecté (Lien)" "$text" true
    else
        notify "Code QR détecté" "$text" false
    fi
}

case "${1:-}" in
    -h|--help)
        echo "Usage: qr-scan [OPTION] [FICHIER]"
        echo ""
        echo "Options:"
        echo "  (sans option)      Sélectionner une zone à l'écran pour scanner"
        echo "  <fichier>          Scanner une image existante"
        echo "  -c, --clip         Scanner une image présente dans le presse-papier"
        echo "  -w, --cam          Ouvrir la webcam pour scanner en direct"
        echo "  -h, --help         Afficher cette aide"
        exit 0
        ;;
    -w|--cam)
        echo "Démarrage du scan webcam (fermez la fenêtre ou appuyez sur Ctrl+C pour quitter)..."
        zbarcam --raw 2>/dev/null | while read -r line; do
            if [ -n "$line" ]; then
                process_text "$line"
                killall zbarcam 2>/dev/null || true
                break
            fi
        done
        exit 0
        ;;
    -c|--clip)
        if ! command -v wl-paste >/dev/null 2>&1; then
            notify_err "wl-paste n'est pas installé."
            exit 1
        fi
        raw=$(wl-paste -t image/png 2>/dev/null | zbarimg -q --raw - 2>/dev/null || true)
        process_text "$raw"
        exit 0
        ;;
    "")
        if ! command -v slurp >/dev/null 2>&1 || ! command -v grim >/dev/null 2>&1; then
            notify_err "slurp ou grim n'est pas disponible."
            exit 1
        fi

        geometry=$(slurp 2>/dev/null) || exit 0
        if [ -z "$geometry" ]; then
            exit 0
        fi

        raw=$(grim -g "$geometry" - 2>/dev/null | zbarimg -q --raw - 2>/dev/null || true)
        process_text "$raw"
        exit 0
        ;;
    *)
        if [ -f "$1" ]; then
            raw=$(zbarimg -q --raw "$1" 2>/dev/null || true)
            process_text "$raw"
            exit 0
        else
            echo "Erreur : fichier '$1' introuvable." >&2
            exit 1
        fi
        ;;
esac
