#!/usr/bin/env python3
import html
import json
import os
import re
import sys
import urllib.parse
import urllib.request

def emit(text: str):
    llm_out = os.environ.get("LLM_OUTPUT")
    if llm_out:
        with open(llm_out, "w", encoding="utf-8") as f:
            f.write(text)
    else:
        print(text)

def main():
    if len(sys.argv) < 2:
        emit("Error: missing JSON arguments")
        return
    try:
        args = json.loads(sys.argv[1])
    except Exception as e:
        emit(f"Error parsing JSON arguments: {e}")
        return

    query = args.get("query", "").strip()
    if not query:
        emit("Error: empty query")
        return

    url = "https://html.duckduckgo.com/html/?q=" + urllib.parse.quote_plus(query)
    try:
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"}
        )
        with urllib.request.urlopen(req, timeout=15) as resp:
            page = resp.read().decode("utf-8", errors="replace")

        titles = re.findall(r'class="result__a"[^>]*href="([^"]+)"[^>]*>(.*?)</a>', page, re.S)
        snippets = re.findall(r'class="result__snippet"[^>]*>(.*?)</a>|class="result__snippet"[^>]*>(.*?)</div>', page, re.S)

        results = []
        for idx, (href, raw_title) in enumerate(titles[:5]):
            clean_title = html.unescape(re.sub(r"<[^>]+>", "", raw_title)).strip()
            raw_snip = ""
            if idx < len(snippets):
                raw_snip = snippets[idx][0] or snippets[idx][1]
            clean_snip = html.unescape(re.sub(r"<[^>]+>", "", raw_snip)).strip()
            if "uddg=" in href:
                m = re.search(r"uddg=([^&]+)", href)
                if m:
                    href = urllib.parse.unquote(m.group(1))
            results.append({
                "title": clean_title,
                "url": href,
                "snippet": clean_snip
            })

        if not results:
            emit(f"Aucun résultat trouvé pour : {query}")
            return
        emit(json.dumps(results, ensure_ascii=False, indent=2))
    except Exception as e:
        emit(f"Erreur de recherche web : {e}")

if __name__ == "__main__":
    main()
