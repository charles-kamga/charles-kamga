#!/usr/bin/env bash
# Wrapper harnais ultra-léger AIChat pour DarwinX, Geek & Scribe
set -euo pipefail

export AICHAT_CONFIG_DIR="${AICHAT_CONFIG_DIR:-/home/charles/Projects/Personal/Admin_OS/test-configs/aichat}"
AICHAT_BIN="${AICHAT_BIN:-/home/charles/Projects/Personal/Admin_OS/test-configs/aichat/bin/aichat}"

if command -v aichat >/dev/null 2>&1; then
    AICHAT_BIN="$(command -v aichat)"
fi

AGENT_NAME="$(basename "$0")"
case "$AGENT_NAME" in
    geek|geek-chat)
        MODEL="ollama:geek:latest"
        ;;
    scribe|scribe-chat)
        MODEL="ollama:scribe:latest"
        ;;
    *)
        MODEL="ollama:darwinx:latest"
        ;;
esac

exec "$AICHAT_BIN" -m "$MODEL" "$@"
